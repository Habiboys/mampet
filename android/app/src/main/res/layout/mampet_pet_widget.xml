<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Left: Animated Moving Active Pet via native ViewFlipper -->
    <FrameLayout
        android:id="@+id/pet_stage_container"
        android:layout_width="106dp"
        android:layout_height="106dp">

        <ViewFlipper
            android:id="@+id/pet_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="520">

            <ImageView
                android:id="@+id/pet_frame_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="MamPet gerak 1"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/pet_frame_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="MamPet gerak 2"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/pet_frame_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="MamPet gerak 3"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/pet_frame_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="MamPet gerak 4"
                android:scaleType="fitCenter" />
        </ViewFlipper>
    </FrameLayout>

    <!-- Right: Pet Info, Speech Bubble, XP & Quick CTA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_pet_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="MamPet"
                android:textColor="#2D201B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_pet_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_bg"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Lv 1"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_pet_speech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/widget_bubble_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="Yuk catat makan hari ini!"
            android:textColor="#6B584F"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_xp_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="25"
            android:progressDrawable="@drawable/widget_xp_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_pet_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Baby • ♥ 0"
                android:textColor="#6B584F"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_open_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_bg"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="+ Catat"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
